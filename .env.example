TELEGRAM_BOT_TOKEN=your_bot_token_here
DART_API_KEY=your_dart_api_key_here
ALLOWED_CHAT_IDS=123456789,987654321

# kreports DB 경로 (kreports_dart_mcp의 kreports.db를 가리킴)
DB_URL=sqlite:////path/to/kreports_dart_mcp/kreports.db

# TradingView 직접 스캔 캐시 (추천 후보 반복 조회 속도 보강)
TRADINGVIEW_SCAN_CACHE_PATH=./state/tradingview_scan_cache.sqlite3
TRADINGVIEW_SCAN_CACHE_TTL_SECONDS=600
